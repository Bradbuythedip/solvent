# --- mode -------------------------------------------------------------------
# demo = deterministic simulator, no network, no keys. live = read Arc.
SOLVENT_MODE=demo
SOLVENT_CHAIN=arcTestnet

# --- Arc --------------------------------------------------------------------
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# --- services ---------------------------------------------------------------
SOLVENT_INDEXER_PORT=8787
SOLVENT_INDEXER_URL=http://localhost:8787
NEXT_PUBLIC_INDEXER_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- keys (never commit a real one) ----------------------------------------
PRIVATE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- agent safety rails -----------------------------------------------------
SOLVENT_MAX_SPEND_PER_ACTION_6=50000
SOLVENT_ALLOWANCE_CAP_6=10000000
