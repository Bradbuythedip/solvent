{
  "name": "@solvent/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sim": {
      "types": "./dist/sim.d.ts",
      "default": "./dist/sim.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "viem": "2.56.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.10.5"
  }
}
