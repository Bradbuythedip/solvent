  "devDependencies": {
    "hardhat": "3.17.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "typescript": "5.9.3",
    "@types/node": "22.10.5",
    "viem": "2.56.8"
  }
}
